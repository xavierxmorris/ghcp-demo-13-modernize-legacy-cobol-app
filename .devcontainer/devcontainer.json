{
  "name": "COBOL to Node.js modernisation lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 2
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // GnuCOBOL 3.1.2, pinned to match .github/workflows/ci.yml. `gnucobol` is a
  // transitional package that installs the 4.0 pre-release, and the Ubuntu 20.04
  // image behind devcontainers/universal only carries GnuCOBOL 2.2. Pinning keeps
  // the recorded golden master reproducible everywhere.
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends gnucobol3",
  "postCreateCommand": "npm run build:cobol && npm test",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "bitlang.cobol",
        "DavidAnson.vscode-markdownlint",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": false
      }
    }
  }
}